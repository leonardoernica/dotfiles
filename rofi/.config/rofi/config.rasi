configuration {
    font: "Noto Sans 13";
    show-icons: true;
    matching: "fuzzy";
    sorting-method: "fzf";
    sort: true;
    case-smart: true;
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";
}

* {
    panel: rgba(24, 25, 28, 96%);
    outline: rgba(255, 255, 255, 8%);
    text: #f3f4f6;
    muted: #a1a1aa;
    accent: #a8c7fa;
    selected: #303237;
}

window {
    width: 36%;
    location: center;
    anchor: center;
    transparency: "real";
    padding: 8px;
    border: 1px;
    border-color: @outline;
    border-radius: 20px;
    background-color: @panel;
}

mainbox {
    padding: 14px;
    background-color: transparent;
}

inputbar {
    children: [ "entry" ];
    padding: 13px 14px;
    border: 0px 0px 1px;
    border-color: @outline;
    background-color: transparent;
}

entry {
    placeholder: "Buscar aplicativos";
    placeholder-color: @muted;
    text-color: @text;
    cursor: text;
    background-color: transparent;
}

listview {
    lines: 6;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 2px;
    padding: 10px 0px 0px;
    border: 0px;
    border-color: transparent;
}

message,
sidebar {
    border: 0px;
    border-color: transparent;
    background-color: transparent;
}

element {
    padding: 9px 12px;
    spacing: 12px;
    border-radius: 10px;
    border: 0px;
    background-color: transparent;
    text-color: @text;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active,
element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @text;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @selected;
    text-color: @text;
}

element-icon {
    size: 1.15em;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    highlight: bold #a8c7fa;
    background-color: transparent;
}

scrollbar {
    enabled: false;
}
