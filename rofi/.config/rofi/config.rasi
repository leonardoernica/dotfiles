configuration {
    font: "Noto Sans 12";
    show-icons: true;
    matching: "fuzzy";
    sorting-method: "fzf";
    sort: true;
    case-smart: true;
    display-drun: "Apps";
    drun-display-format: "{name} [<span alpha='58%' size='small'>· {generic}</span>]";
    drun-match-fields: "name,generic,exec,categories,keywords";
}

* {
    bg: rgba(17, 19, 24, 88%);
    row: rgba(255, 255, 255, 4%);
    outline: rgba(255, 255, 255, 10%);
    text: #eef1f6;
    muted: #9aa3b2;
    accent: #70d7e8;
    selected: rgba(112, 215, 232, 14%);
}

window {
    width: 40%;
    location: center;
    anchor: center;
    y-offset: -36px;
    transparency: "real";
    border: 1px;
    border-color: @outline;
    border-radius: 18px;
    background-color: @bg;
}

mainbox {
    padding: 14px;
    background-color: transparent;
}

inputbar {
    padding: 10px 12px 14px;
    spacing: 12px;
    border: 0px 0px 1px;
    border-color: @outline;
    background-color: transparent;
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

textbox-prompt-colon {
    enabled: false;
}

entry {
    placeholder: "Buscar apps e abrir";
    placeholder-color: @muted;
    text-color: @text;
    cursor: text;
    background-color: transparent;
}

num-filtered-rows,
textbox-num-sep,
num-rows {
    text-color: @muted;
    background-color: transparent;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 4px;
    padding: 12px 0px 2px;
}

element {
    padding: 9px 12px;
    spacing: 12px;
    border: 0px 0px 0px 2px;
    border-color: transparent;
    border-radius: 9px;
    background-color: transparent;
    text-color: @text;
}

element alternate.normal {
    background-color: @row;
}

element selected.normal {
    border-color: @accent;
    background-color: @selected;
    text-color: @text;
}

element-icon {
    size: 1.25em;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    highlight: bold #70d7e8;
    background-color: transparent;
}

scrollbar {
    enabled: false;
}
