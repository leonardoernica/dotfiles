[Unit]
Description=Garimpo semantic file indexer
After=graphical-session.target garimpo-embed.service
Wants=garimpo-embed.service

[Service]
ExecStart=%h/.local/bin/garimpo index --watch
Restart=on-failure
RestartSec=30
Nice=19
IOSchedulingClass=idle
CPUWeight=20
MemoryHigh=1500M

[Install]
WantedBy=default.target
