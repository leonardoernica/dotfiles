#!/bin/sh
# SUPER+D: wake the resident window over D-Bus (instant); start it if it is not running.
if [ $# -eq 0 ] && busctl --user call io.github.leonardoernica.Garimpo /io/github/leonardoernica/Garimpo \
    org.freedesktop.Application Activate 'a{sv}' 0 >/dev/null 2>&1; then
    exit 0
fi
exec python3 "$(dirname "$(readlink -f "$0")")/../share/garimpo/garimpo.py" "$@"
